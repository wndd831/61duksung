rules_version = '2';

// 방명록: 누구나 읽기 / 정해진 모양의 메모만 새로 붙이기 / 수정·삭제는 불가(관리자는 콘솔에서 삭제)
service cloud.firestore {
  match /databases/{database}/documents {
    match /guestbook/{noteId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['from', 'message', 'left', 'top', 'rot', 'color', 'createdAt'])
        && request.resource.data.from is string
        && request.resource.data.from.size() > 0 && request.resource.data.from.size() <= 10
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 50
        && request.resource.data.color in ['orange', 'blue']
        && request.resource.data.left is number && request.resource.data.left >= 0 && request.resource.data.left <= 100
        && request.resource.data.top is number && request.resource.data.top >= 0 && request.resource.data.top <= 200000
        && request.resource.data.rot is number && request.resource.data.rot >= -10 && request.resource.data.rot <= 10
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // 광장: 누구나 읽기 / 종이접기 카드 한 장씩 새로 붙이기 / 수정·삭제 불가
    match /plaza/{paperId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['cid', 'layers', 'word', 'name', 'bg', 'x', 'y', 'rot', 'createdAt'])
        && request.resource.data.cid is string && request.resource.data.cid.size() <= 40
        && request.resource.data.layers is string
        && request.resource.data.layers.size() > 2 && request.resource.data.layers.size() <= 30000
        && request.resource.data.word is string && request.resource.data.word.size() <= 10
        && request.resource.data.name is string && request.resource.data.name.size() <= 10
        && request.resource.data.bg in ['orange', 'blue', 'white', 'black']
        && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
        && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 100
        && request.resource.data.rot is number && request.resource.data.rot >= -15 && request.resource.data.rot <= 15
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
