rules_version = '2';

// 방명록: 누구나 읽기 / 정해진 모양의 메모만 새로 붙이기 / 수정·삭제는 불가(관리자는 콘솔에서 삭제)
service cloud.firestore {
  match /databases/{database}/documents {
    match /guestbook/{noteId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['from', 'message', 'left', 'top', 'rot', 'color', 'createdAt'])
        && request.resource.data.from is string
        && request.resource.data.from.size() > 0 && request.resource.data.from.size() <= 10
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 50
        && request.resource.data.color in ['orange', 'blue']
        && request.resource.data.left is number && request.resource.data.left >= 0 && request.resource.data.left <= 100
        && request.resource.data.top is number && request.resource.data.top >= 0 && request.resource.data.top <= 200000
        && request.resource.data.rot is number && request.resource.data.rot >= -10 && request.resource.data.rot <= 10
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
